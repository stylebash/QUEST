#Requires AutoHotkey v2.0
#SingleInstance Force
#Include ../lib/outputDebugOverload.ahk
#Include ../lib/JSON.ahk ; cJSON by G33kDude
#Include ../QUEST.ahk

/**
 * Maybe you're debugging and you want to trace events of your program and maybe QUEST itself?
 */

try {
  ; -- REQUIRED --
  ; Turn on trace logging first, it's `false` by default.
  QUEST.traceAndLog := true

  ; -- OPTIONAL --
  ; If you really want to create a different log file from the default.
  ; QUEST.traceAndLogFileName := "someOtherFile.log"

  ; Where is this log file located?
  ;   - It will be created and located in the same directory as where the script calling QUEST.TraceLogger is located.

  Init()
} catch Error as err {
  ; How we add a new line of log data to the log file
  ; just pass a string
  QUEST.TraceLogger("Layer 1 Top-Level Fatal Error: " . err.Message . " (Line " . err.Line . " in " . err.What . ")")
}

Init() {
  QUEST.missionFile := "usage-08-trace-logging-mission.ahk"
  QUEST.missionDeadline := 1067

  ; Let's add a trace before dispatching
  QUEST.TraceLogger("Did our mission deadline just do a 6 7?")

  QUEST.Dispatch('just come back home', traceLoggingDemoCallbackFunk)
}

traceLoggingDemoCallbackFunk(results) {
  ; And another trace at the callback
  QUEST.TraceLogger("Everybody cringes")

  OutputDebug results
}

/**
 * Open the directory where this file is located and you'll find the log file.
 * Open the log file. Besides the log data we passed from this file, you'll see 
 * some other log data in there that was not generated by this script.
 *   - These lines were created inside the QUEST class to track and trace adventurer missions.
 */


/**
 * -- REVIEW --
 * In this demo, we learned that:
 * 1. If we are debugging and want to start logging a trace of events of our program,
 *    we have to set QUEST.traceAndLog to `true` first.
 * 2. We add traces by calling and passing a string to QUEST.TraceLogger('<your string here>').
 * 3. There are traces created inside the QUEST class to track and trace adventurer missions.
 *   - This will only generate log data if QUEST.traceAndLog is set to `true`.
 * 4. The log file is created in the same directory as where the script calling QUEST.TraceLogger is located.
 */